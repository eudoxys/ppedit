//
// dclinecost (module pypower has no DC line cost class; same properties as pypower.gencost)
//
class dclinecost
{
    enumeration {UNKNOWN=0,PIECEWISE=1,POLYNOMIAL=2} model;
    double startup[$];
    double shutdown[$];
    char1024 costs;
}
object dclinecost
{
    name "pp_dclinecost_1";
    parent "pp_dcline_1";
    model POLYNOMIAL;
    startup 0 $;
    shutdown 0 $;
    costs "0,0";
}
